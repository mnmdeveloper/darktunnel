ENVIRONMENT=production
PUBLIC_API_URL=https://api.example.com
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://darktunnel:CHANGE_ME@db:5432/darktunnel
REDIS_URL=redis://redis:6379/0

# Enter only on the VPS. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
ACTIVATION_ENCRYPTION_KEY=

WDTT_ENV_PATH=/host/etc/wdtt/wdtt.env
WDTT_PUBLIC_HOST=31.77.148.80
WDTT_PUBLIC_PORT=56000
WDTT_MODE=srtp-wrap-a
WDTT_CONNECTIONS_BALANCED=3
WDTT_CONNECTIONS_MAXIMUM=10
WDTT_MTU=1280
WDTT_DNS=1.1.1.1
